# Copy to `.streamlit/secrets.toml` for local runs, or paste into
# Streamlit Cloud / hosted app secrets. Never commit secrets.toml to git.

[auth]
cookie_name = "cleanmap_auth"
cookie_key = "replace-with-a-long-random-string"
cookie_expiry_days = 30

[auth.credentials.usernames.admin]
email = "admin@yourcompany.com"
name = "Admin User"
password = "ChangeThisPassword123"

[auth.credentials.usernames.analyst]
email = "analyst@yourcompany.com"
name = "Migration Analyst"
password = "AnotherSecurePassword456"

[cloud]
enabled = true
supabase_url = "https://YOUR_PROJECT.supabase.co"
supabase_key = "YOUR_SUPABASE_SERVICE_ROLE_KEY"
bucket = "cleanmap-files"
