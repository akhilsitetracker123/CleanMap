# Copy to `.streamlit/secrets.toml` for local runs.
# For Streamlit Cloud: paste this ENTIRE file into App settings → Secrets.

[auth]
cookie_name = "cleanmap_auth"
cookie_key = "replace-with-a-long-random-string"
cookie_expiry_days = 30

[auth.credentials.usernames.admin]
email = "admin@yourcompany.com"
name = "admin"
password = "admin123"

[cloud]
enabled = true

# Storage provider: "bitbucket" or "supabase" (if omitted, Bitbucket is used when bitbucket_* keys exist)
provider = "bitbucket"

# --- Bitbucket (recommended if you use Bitbucket already) ---
# Use a DEDICATED repo for Excel files (e.g. cleanmap-data), not the app source repo.
bitbucket_workspace = "sitetraker"
bitbucket_repo = "cleanmap-data"
bitbucket_branch = "main"
bitbucket_root = "cleanmap-files"
# With API token: use Atlassian email + token (NOT your Bitbucket login password)
bitbucket_username = "you@yourcompany.com"
bitbucket_app_password = "paste_bitbucket_api_token"

# --- Supabase (alternative) ---
# provider = "supabase"
# supabase_url = "https://YOUR_PROJECT.supabase.co"
# supabase_key = "YOUR_SUPABASE_SERVICE_ROLE_KEY"
# bucket = "cleanmap-files"