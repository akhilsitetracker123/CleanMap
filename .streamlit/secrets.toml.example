# Copy to `.streamlit/secrets.toml` for local runs.
# For Streamlit Cloud: paste this ENTIRE file into App settings → Secrets.
# Do NOT use placeholder passwords — match what works locally.

[auth]
cookie_name = "cleanmap_auth"
cookie_key = "replace-with-a-long-random-string"
cookie_expiry_days = 30

# Sign in with username "admin" (not email) and the password below.
[auth.credentials.usernames.admin]
email = "admin@yourcompany.com"
name = "admin"
password = "admin123"

[cloud]
enabled = true
supabase_url = "https://YOUR_PROJECT.supabase.co"
supabase_key = "YOUR_SUPABASE_SERVICE_ROLE_KEY"
bucket = "cleanmap-files"
